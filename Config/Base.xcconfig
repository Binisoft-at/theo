// Binisoft conventions: every identifier lives here, nothing is hard-coded elsewhere.
// Watch app: $(APP_BUNDLE_ID).watchkitapp · extensions/widgets: $(APP_BUNDLE_ID).<extension>

BUNDLE_ID_PREFIX = at.binisoft
DEVELOPMENT_TEAM =
APP_BUNDLE_ID = $(BUNDLE_ID_PREFIX).theo
APP_CLOUDKIT_CONTAINER = iCloud.$(APP_BUNDLE_ID)
SHARED_APP_GROUP = group.$(BUNDLE_ID_PREFIX).shared
SHARED_CLOUDKIT_CONTAINER = iCloud.$(BUNDLE_ID_PREFIX).shared
SHARED_KEYCHAIN_GROUP = $(AppIdentifierPrefix)$(BUNDLE_ID_PREFIX).shared
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Local overrides (e.g. DEVELOPMENT_TEAM for running from Xcode), not committed.
#include? "Local.xcconfig"
